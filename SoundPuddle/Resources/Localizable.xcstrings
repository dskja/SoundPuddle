    "error.bonjour.livecontainer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer blockiert Multipeer-Bonjour (_soundpuddle), auch wenn Local Network an ist. SoundPuddle wechselt auf LAN-Discovery — Session neu starten. Host und Gäste brauchen dasselbe WLAN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer blocks Multipeer Bonjour (_soundpuddle) even with Local Network on. SoundPuddle switches to LAN discovery — restart the session. Host and guests need the same Wi‑Fi."
          }
        }
      }
    },
    "error.bonjour.localNetwork": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Netzwerk nicht erlaubt oder Bonjour-Timeout. Unter Einstellungen → SoundPuddle → Lokales Netzwerk einschalten, WLAN prüfen, dann Session neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network denied or Bonjour timed out. Enable Local Network under Settings → SoundPuddle, check Wi‑Fi, then restart the session."
          }
        }
      }
    },
