    "livecontainer.banner.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen (Lokales Netzwerk, Mikrofon, Bluetooth) gehören zur LiveContainer-Host-App. Dateiauswahl: „Fix File Picker“ aktivieren. Für stabiles Audio Multitask-Modus vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions (Local Network, Mic, Bluetooth) belong to the LiveContainer host app. For files enable “Fix File Picker”. Avoid multitask mode for stable audio."
          }
        }
      }
    },
    "livecontainer.tip.host": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In LiveContainer: Lokales Netz & Mikrofon in den LiveContainer-Einstellungen erlauben. Soft-Encryption ist aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In LiveContainer: allow Local Network & Microphone in LiveContainer settings. Soft encryption is active."
          }
        }
      }
    },
    "livecontainer.tip.join": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In LiveContainer: Lokales Netz in den LiveContainer-Einstellungen erlauben, dann erneut suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In LiveContainer: allow Local Network in LiveContainer settings, then search again."
          }
        }
      }
    },
    "livecontainer.tip.audio": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwaches Audio in LiveContainer? Multitask aus, Host-App im Vordergrund lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weak audio in LiveContainer? Turn off multitask and keep the host app foregrounded."
          }
        }
      }
    },
