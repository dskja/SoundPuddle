    "livecontainer.banner.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechte gehören zur LiveContainer-Host-App (Local Network kann an sein). Multipeer-Bonjour (_soundpuddle) ist dort trotzdem gesperrt — SoundPuddle nutzt LAN-Discovery. Gleiches WLAN, VPN aus, Session neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions belong to the LiveContainer host app (Local Network can be on). Multipeer Bonjour (_soundpuddle) is still blocked there — SoundPuddle uses LAN discovery. Same Wi‑Fi, VPN off, restart the session."
          }
        }
      }
    },
    "livecontainer.tip.host": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer: Local Network kann an sein — Multipeer bleibt gesperrt. SoundPuddle hostet per LAN-Discovery."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer: Local Network can be on — Multipeer stays blocked. SoundPuddle hosts via LAN discovery."
          }
        }
      }
    },
    "livecontainer.tip.join": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer: Local Network kann an sein — Multipeer bleibt gesperrt. SoundPuddle sucht per LAN-Discovery."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer: Local Network can be on — Multipeer stays blocked. SoundPuddle browses via LAN discovery."
          }
        }
      }
    },
    "livecontainer.tip.audio": {
      "localizations": {
