      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungen (Lokales Netzwerk, Mikrofon, Bluetooth) gehören zur LiveContainer-Host-App. Dateiauswahl: „Fix File Picker“ aktivieren. Für stabiles Audio Multitask-Modus vermeiden."
