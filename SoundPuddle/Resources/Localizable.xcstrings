      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN-Discovery in LiveContainer fehlgeschlagen. Prüfe: gleiches WLAN, Local Network für LiveContainer an, VPN/Privat-Relay aus, dann Session neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN discovery in LiveContainer failed. Check: same Wi‑Fi, Local Network enabled for LiveContainer, VPN/Private Relay off, then restart the session."
          }
        }
      }
